# This workflow is managed by gh actions-lock.
# SPDX-License-Identifier: MPL-2.0
# {{PROJECT_NAME}} — docs build & deploy (julia-library archetype)
#
# Split into an unprivileged `build` job (`contents: read`, no write token
# exposed to untrusted package/doc evaluation — issue #232) and a minimal
# `deploy` job (`contents: write`) that publishes only the pre-built artifact
# to `gh-pages` on default-branch pushes.

name: Docs

on:
  push:
    branches: [main, master]
  pull_request:
  workflow_dispatch:

permissions:
  contents: read

concurrency:
  group: julia-docs-${{ github.ref }}
  cancel-in-progress: true

jobs:
  build:
    name: Build docs (read-only)
    runs-on: ubuntu-24.04
    timeout-minutes: 15
    permissions:
      contents: read
    steps:
      - uses: actions/checkout@v7.0.1
        with:
          persist-credentials: false
      - name: Layout gate — fail loud while docs/ is absent
        run: |
          if [ ! -f docs/Project.toml ] || [ ! -f docs/make.jl ] || [ ! -d docs/src ]; then
            echo "::error::docs-site declared but no Documenter build: docs/Project.toml, docs/make.jl and docs/src/ are required. Either add the build or drop the docs-site capability from the repo deed's (rsr-profile) clause."
            exit 1
          fi
      - uses: julia-actions/setup-julia@v3.0.2
        with:
          version: "1"
      - uses: julia-actions/cache@v3.5.0
      - name: Instantiate the docs environment
        run: julia --project=docs -e 'using Pkg; Pkg.develop(PackageSpec(path=pwd())); Pkg.instantiate()'
      - name: Build static site without write credentials
        env:
          # Suppress Documenter deploydocs push inside the build job; deploy
          # happens in the isolated job below without executing Julia code.
          GITHUB_EVENT_NAME: pull_request
        run: |
          julia --project=docs docs/make.jl
          test -d docs/build
      - name: Upload built site artifact
        uses: actions/upload-artifact@v7.0.2
        with:
          name: julia-docs-site
          path: docs/build
          retention-days: 5

  deploy:
    name: Deploy docs to gh-pages
    needs: build
    if: (github.event_name == 'push' || github.event_name == 'workflow_dispatch') && (github.ref == 'refs/heads/main' || github.ref == 'refs/heads/master')
    runs-on: ubuntu-24.04
    timeout-minutes: 10
    permissions:
      contents: write
    steps:
      - name: Download built site artifact
        uses: actions/download-artifact@v8.0.2
        with:
          name: julia-docs-site
          path: site
      - name: Publish static site to gh-pages branch
        env:
          REPO: ${{ github.repository }}
          SHA: ${{ github.sha }}
          TOKEN: ${{ github.token }}
        run: |
          set -euo pipefail
          AUTH="AUTHORIZATION: basic $(printf 'x-access-token:%s' "${TOKEN}" | base64 -w0)"
          touch site/.nojekyll
          git -C site init -q -b gh-pages
          git -C site config user.name "github-actions[bot]"
          git -C site config user.email "41898282+github-actions[bot]@users.noreply.github.com"
          git -C site add -A
          git -C site commit -q -m "docs: deploy ${SHA:0:12}"
          git -C site -c http.extraheader="${AUTH}" push -q --force "https://github.com/${REPO}.git" gh-pages:gh-pages
